# Copie para .env e preencha. Nunca publique o .env no GitHub.

# Chave secreta das sessões: 40+ caracteres aleatórios.
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# Banco de dados. Vazio = SQLite local em api/data/estuda.sqlite3
# Nuvem (Supabase, Neon...): postgresql://usuario:senha@host:5432/banco
DATABASE_URL=

# Inteligência artificial (opcional, mas é o que gera aulas e lê editais e provas)
# AI_PROVIDER: anthropic | openai | gemini
#   anthropic -> Claude.        AI_MODEL padrão: claude-sonnet-5-5 (mais barato: claude-haiku-5-5)
#   openai    -> OpenAI ou qualquer API compatível (Groq, OpenRouter, Ollama) via AI_BASE_URL
#   gemini    -> Google Gemini. AI_MODEL padrão: gemini-2.5-flash (tem camada gratuita)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Pedidos de IA por aluno por dia (administradores não têm limite)
AI_DAILY_LIMIT=40

# E-mail que vira administrador ao criar a conta (recomendado em sites publicados)
ADMIN_EMAIL=

# 1 = qualquer pessoa pode criar conta; 0 = só o administrador cria (o 1º cadastro sempre é liberado)
ALLOW_SIGNUP=1

# Pacotes de conteúdo carregados no primeiro início (banco vazio)
SEED_PACKS=ti_birigui,pcsp_escrivao
