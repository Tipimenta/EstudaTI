# Renomeie este arquivo para .env. TROQUE ambas as credenciais.
APP_PASSWORD=TROQUE_POR_SENHA_UNICA_COM_12_OU_MAIS_CARACTERES
# Para gerar: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=TROQUE_POR_CHAVE_ALEATORIA_DE_64_CARACTERES
# Porta local de acesso ao frontend
HOST_PORT=8088
# Por padrão não expor a rede/internet; para acesso privado, configure proxy/VPN adequadamente.
BIND_ADDR=127.0.0.1
# Alterar somente após terminar de configurar HTTPS no servidor de publicação.
COOKIE_SECURE=false
ENABLE_MONITOR=true

# Opcional: tutor por IA via OpenAI API, com cobranca independente da assinatura ChatGPT.
# NUNCA compartilhe seu arquivo .env. Deixe em branco para usar modo guiado local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
